NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_USERNAME=replace-with-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-unique-strong-password
# ใส่หมายเลข PromptPay หรือเลขประจำตัวผู้เสียภาษีที่ใช้รับเงินจริง ก่อนเปิดรับชำระเงิน
PROMPTPAY_ID=
STORE_NAME=Nobi Topup

# Apps Script gateway — required on Vercel/production; local SQLite fallback is development-only
APPS_SCRIPT_URL=
APPS_SCRIPT_SHARED_SECRET=
APPS_SCRIPT_TIMEOUT_MS=30000

# SESSION_SECRET / ADMIN_USERNAME / ADMIN_PASSWORD are for local SQLite development only.
# On Vercel, Admin credentials and sessions are stored in Apps Script/Sheets.
# Set NOBI_GATEWAY_SECRET, NOBI_PRIVATE_DRIVE_FOLDER_ID and NOBI_PRIVATE_MEDIA_FOLDER_ID
# as Google Apps Script Script Properties, not as values in this file.
